{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TV7 Studio",
  "version": "0.1.0",
  "identifier": "com.tv7.studio",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TV7 Studio",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Video",
    "externalBin": ["binaries/engine-service"],
    "macOS": {
      "files": {
        "Resources/yt-dlp/yt-dlp-macos": "./binaries/yt-dlp-macos",
        "Resources/yt-dlp/_internal": "./binaries/yt-dlp-internal"
      }
    }
  }
}
